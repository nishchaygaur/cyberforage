# CYBERFORAGE SUPABASE CONFIGURATION
# Obtain these values from your Supabase Project Settings -> API:
# https://app.supabase.com/project/_/settings/api

# Public URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe for browser distribution with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dedicated administrator email
VITE_ADMIN_EMAIL=nishchay.gaur.official@gmail.com
